# Stock Data Updater Configuration
# Copy this file to .env and update with your actual values

# Financial Modeling Prep API Key
FMP_API_KEY=bf7fead9d19d4edb672503f815f93ba5

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=financial_agent

# Update Schedule (IST timezone)
UPDATE_HOUR=3
UPDATE_MINUTE=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=stock_updater.log

# API Configuration
API_TIMEOUT=30
BATCH_SIZE=1000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=60
